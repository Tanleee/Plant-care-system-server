doctype html
html
  head
    meta(name='viewport', content='width=device-width')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject
    
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #1a2332;
        padding: 20px;
        line-height: 1.6;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }
      .header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        padding: 40px 30px;
        text-align: center;
        position: relative;
      }
      .header::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #4A90E2, #5fba7d, #4A90E2);
      }
      .logo-container {
        display: inline-block;
        margin-bottom: 15px;
      }
      .logo-icon {
        font-size: 48px;
        margin-bottom: 10px;
      }
      .logo {
        font-size: 32px;
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
      }
      .logo-smart {
        color: #5fba7d;
      }
      .tagline {
        color: #b8c5d6;
        font-size: 14px;
        font-weight: 400;
      }
      .content {
        padding: 40px 30px;
        background: #ffffff;
      }
      .greeting {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 20px;
        font-weight: 600;
      }
      .message {
        color: #4b5563;
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 20px;
      }
      .message p {
        margin-bottom: 12px;
      }
      .btn-container {
        text-align: center;
        margin: 35px 0;
      }
      .btn {
        display: inline-block;
        padding: 16px 40px;
        background: linear-gradient(135deg, #4A90E2 0%, #5B9BD5 100%);
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 30px;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(74, 144, 226, 0.4);
      }
      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(74, 144, 226, 0.6);
        background: linear-gradient(135deg, #5B9BD5 0%, #4A90E2 100%);
      }
      .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
        margin: 30px 0;
      }
      .info-box {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border-left: 4px solid #4A90E2;
        padding: 20px;
        border-radius: 8px;
        margin: 25px 0;
      }
      .info-box p {
        color: #334155;
        font-size: 14px;
        margin: 10px 0;
        line-height: 1.6;
      }
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin: 25px 0;
      }
      .feature-item {
        background: #f8fafc;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        text-align: center;
      }
      .feature-icon {
        font-size: 32px;
        margin-bottom: 8px;
      }
      .feature-text {
        color: #475569;
        font-size: 13px;
        font-weight: 500;
      }
      .footer {
        background: #f8fafc;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }
      .footer-text {
        color: #64748b;
        font-size: 13px;
        margin: 8px 0;
      }
      .footer-text a {
        color: #4A90E2;
        text-decoration: none;
      }
      .footer-text a:hover {
        text-decoration: underline;
      }
      .footer-brand {
        color: #2c3e50;
        font-weight: 600;
        font-size: 14px;
      }
      @media only screen and (max-width: 600px) {
        body {
          padding: 10px;
        }
        .header {
          padding: 30px 20px;
        }
        .content {
          padding: 30px 20px;
        }
        .greeting {
          font-size: 20px;
        }
        .message {
          font-size: 15px;
        }
        .btn {
          padding: 14px 30px;
          font-size: 15px;
        }
        .feature-grid {
          grid-template-columns: 1fr;
        }
      }

  body
    .email-container
      //- HEADER
      .header
        .logo-container
          .logo-icon 🌱
        .logo
          span.logo-smart Smart
          span Plant
          |  Monitor
        .tagline Smart Agriculture Monitoring System

      //- CONTENT
      .content
        block content

      //- FOOTER
      .footer
        .footer-brand SmartPlant Monitor
        .footer-text Hệ thống giám sát cây trồng thông minh
        .footer-text
          | Email: 
          a(href='mailto:support@smartplant.io') support@smartplant.io
        
        .divider
        
